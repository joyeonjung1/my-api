# 이 파일은 예시입니다. 실제 값은 .env(로컬) 또는 Railway Variables(배포)에 넣으세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# 접근을 허용할 프론트엔드 주소. 쉼표로 구분, 끝에 / 없이, '*' 금지
# 로컬:   http://localhost:3000,http://localhost:5500
# 배포:   https://your-shop.vercel.app
FRONT_ORIGINS=http://localhost:3000,http://localhost:5500

# API 문서(/docs) 표시 여부. 로컬에서만 1, Railway에서는 넣지 마세요.
ENABLE_DOCS=1

# (선택) IP당 1분 요청 제한
# RATE_LIMIT_READ=120
# RATE_LIMIT_WRITE=30
